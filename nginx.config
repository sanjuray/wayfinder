# ─────────────────────────────────────────────────────────────────────────────
# nginx site config for the Wayfinder SPA.
#
# Two jobs:
#   1. Serve the compiled Angular app, with SPA fallback (any unknown path
#      returns index.html so client-side routing works on refresh/deep-link).
#   2. Reverse-proxy /api/* to the backend, so the browser talks to ONE origin.
#
# The single-origin trick is the key production decision: the browser sees only
# https://wayfinder.app for both the app and the API, so the auth cookie stays
# SameSite=Strict and NO CORS is involved. This is simpler and safer than
# exposing the API on a separate subdomain and loosening cookie/CORS settings.
#
# The backend host is templated via the BACKEND_URL env var, substituted at
# container start (see the compose command / entrypoint note below).
# ─────────────────────────────────────────────────────────────────────────────
 
server {
    # 8080 so nginx workers need no root. The container/LB maps public 80/443
    # onto this.
    listen 8080;
    server_name _;
 
    root /usr/share/nginx/html;
    index index.html;
 
    # Gzip text assets. (Brotli would need a custom nginx build; gzip is plenty.)
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
 
    # ---- API reverse proxy --------------------------------------------------
    # Everything under /api goes to the backend. Because this is same-origin
    # from the browser's view, the cookie rides along automatically and there's
    # no preflight/CORS dance.
    #
    # ${BACKEND_URL} is substituted at container start (envsubst) — e.g.
    # http://backend:8080 inside compose, or the internal service URL in prod.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Don't buffer indefinitely; surface backend slowness as a timeout.
        proxy_connect_timeout 5s;
        proxy_read_timeout    30s;
    }
 
    # ---- Static assets with long cache --------------------------------------
    # Angular fingerprints filenames (main.abc123.js), so hashed assets can be
    # cached hard. index.html must NOT be cached long or clients pin an old app.
    location ~* \.(?:js|css|woff2?|png|jpg|jpeg|gif|svg|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
 
    # ---- SPA fallback -------------------------------------------------------
    # Any other path → index.html, so Angular's router handles it. index.html
    # itself is served with no-cache so a new deploy is picked up immediately.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
 
    # A tiny liveness endpoint for the container healthcheck (doesn't touch the
    # backend — just proves nginx is up and serving).
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }
}
